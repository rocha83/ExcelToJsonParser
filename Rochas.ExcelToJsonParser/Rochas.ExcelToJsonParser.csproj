<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>Rochas.ExcelToJson</RootNamespace>
    <AssemblyName>Rochas.ExcelToJsonParser</AssemblyName>
    <Authors>Renato Rocha</Authors>
    <Version>1.6.4</Version>
    <PackageId>Rochas.ExcelToJsonParser</PackageId>
    <Description>Bidirectional Excel ↔ JSON/CSV/XML converter</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageIcon>json-file.png</PackageIcon>
    <RepositoryType>Git</RepositoryType>
    <RepositoryUrl>https://github.com/rocha83br/ExcelToJsonParser</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.3" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.9.0" />
    <PackageReference Include="NJsonSchema" Version="10.1.16" />
    <PackageReference Include="NJsonSchema.CodeGeneration" Version="10.1.16" />
    <PackageReference Include="NJsonSchema.CodeGeneration.CSharp" Version="10.1.16" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="7.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Update="json-file.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
